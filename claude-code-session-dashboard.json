          },
          "expr": "sum(increase(claude_code_token_usage_tokens_total{job=\"otel-collector\", session_id=\"$session_id\", type=\"cacheRead\"}[$__range])) / sum(increase(claude_code_token_usage_tokens_total{job=\"otel-collector\", session_id=\"$session_id\"}[$__range]))",
